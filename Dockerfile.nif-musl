# Native musl toolchain: no BEAM, ONNX Runtime, or development headers.
FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS build
ARG RUST_VERSION=1.96.1-r0
RUN apk add --no-cache build-base "rust=${RUST_VERSION}" "cargo=${RUST_VERSION}"
ARG TARGET
WORKDIR /build
COPY native/ortex/ ./
RUN case "${TARGET}:$(uname -m)" in \
      aarch64-unknown-linux-musl:aarch64|x86_64-unknown-linux-musl:x86_64) ;; \
      *) echo "target does not match native Alpine architecture" >&2; exit 1 ;; \
    esac && cargo build --release --locked
FROM scratch AS artifact
COPY --from=build /build/target/release/libortex.so /libortex.so
